{
  "name": "web-component-tools-microsite",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.12.0"
  },
  "scripts": {
    "build": "node scripts/build-site.ts",
    "build:production": "SITE_NOINDEX=0 npm run build",
    "build:cloudflare": "npm run build && cf build --mode microsite",
    "build:production:cloudflare": "npm run build:production && cf build --mode microsite-production"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.10",
    "@types/node": "26.6.5",
    "cf": "1.0.0-beta.27",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
